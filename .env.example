# ---------------------------------------------------------------------------
# Adrien — environment configuration
#
# Copy to `.env` and fill in real values:   cp .env.example .env
# `.env` is gitignored and must NEVER be committed.
#
# Key pools are DISCOVERED DYNAMICALLY by numeric suffix: Adrien reads
# GROQ_API_KEY_1, _2, _3, ... until there is a gap. Add or remove accounts by
# adding/removing lines here — no code change needed.
# ---------------------------------------------------------------------------

# --- Groq: LLM inference (primary) + whisper-large-v3 STT ---
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
# GROQ_API_KEY_4=

# --- Gemini: fallback LLM provider when every Groq key is cooling down ---
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# GEMINI_API_KEY_4=
# GEMINI_API_KEY_5=

# --- Fish Audio: TTS ---
FISH_AUDIO_API_KEY_1=
FISH_AUDIO_API_KEY_2=
# FISH_AUDIO_API_KEY_3=

# Fish Audio voice model ("reference") id used for Adrien's voice.
FISH_AUDIO_VOICE_ID=
FISH_AUDIO_VOICE_ID_BACKUP=

# --- Model selection (overridable) ---
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_SMART_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3
GEMINI_FAST_MODEL=gemini-flash-lite-latest
GEMINI_SMART_MODEL=gemini-flash-latest

# --- GitHub ---
GITHUB_TOKEN=

# --- Google OAuth (Calendar + Gmail) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Optional third-party info services (tools degrade gracefully if unset) ---
OPENWEATHER_API_KEY=
NEWSAPI_KEY=
BRAVE_SEARCH_API_KEY=

# --- Minecraft server (home-hosted) ---
MINECRAFT_HOST=rhs.raidnxt.com
MINECRAFT_QUERY_PORT=25565
# Shell commands Adrien runs to control the server. Point these at your own
# start/stop scripts, systemd units, or docker containers.
MINECRAFT_START_CMD=
MINECRAFT_STOP_CMD=
MINECRAFT_RESTART_CMD=

# --- Finance tracker (the user's separate app) ---
FINANCE_TRACKER_URL=https://ledger.raidnxt.com
FINANCE_TRACKER_TOKEN=

# --- Local server ---
ADRIEN_WS_HOST=0.0.0.0
ADRIEN_WS_PORT=8765
# Shared secret clients must present. Generate with: openssl rand -hex 24
ADRIEN_WS_TOKEN=

# --- Paths (defaults are fine) ---
ADRIEN_DATA_DIR=
ADRIEN_LOG_LEVEL=INFO
